{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptPalette Preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "categories", "tags"],
  "properties": {
    "format": { "const": "prompt-palette-preset" },
    "version": { "const": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": ".*\\S.*"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "subcategories"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": ".*\\S.*"
          },
          "subcategories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": ".*\\S.*"
                }
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chinese", "english", "memberships"],
        "properties": {
          "chinese": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": ".*\\S.*"
          },
          "english": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": ".*\\S.*"
          },
          "memberships": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "subcategory"],
              "properties": {
                "category": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": ".*\\S.*"
                },
                "subcategory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": ".*\\S.*"
                }
              }
            }
          }
        }
      }
    }
  }
}
